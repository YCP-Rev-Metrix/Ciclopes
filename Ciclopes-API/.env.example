# RevMetrix API credentials
api_base=api_base
username=string
password=string

API_BASE=api_base
API_USERNAME=string
API_PASSWORD=string

# Request controls
VERIFY_API=true
VERIFY_PRESIGNED=true
PRESIGN_TTL_SECONDS=3600

# HuggingFace token
HF_TOKEN=hf_token

# Inference batch sizes (tune for your VRAM)
# Dev (RTX 5070 Ti 16GB single GPU): 48 / 48
# Prod (RTX 2080 8GB per GPU):       16 / 2
LANE_BALL_BATCH_SIZE=48
SAM3D_BODY_BATCH_SIZE=48

# Dev uses `docker-compose.yaml`, school/prod uses `docker-compose.prod.yaml`.
# Keep the shared ngrok overlay in both so `docker compose up --build` stays the same.
COMPOSE_FILE=docker-compose.yaml:docker-compose.ngrok.yaml

# Leave blank for local-only runs. Set to `ngrok` to start the Cloudflare tunnel sidecar.
COMPOSE_PROFILES=

# Multi-GPU: set to true for 2-GPU production (LaneBall→cuda:0, SAM3D→cuda:1)
MULTI_GPU=false
