# RevMetrix API credentials. Use uppercase names for new environments;
# src/settings.py still accepts lowercase aliases for backward compatibility.
API_BASE=https://api.revmetrix.io
API_USERNAME=your_username
API_PASSWORD=your_password

# Request controls
VERIFY_API=true
VERIFY_PRESIGNED=true
PRESIGN_TTL_SECONDS=3600

# Hugging Face token. The token owner must first be approved for the gated
# facebook/sam-3d-body-dinov3 repository.
HF_TOKEN=hf_token
SAM3D_BODY_HF_REPO_ID=facebook/sam-3d-body-dinov3

# Inference batch sizes (tune for your VRAM)
# Dev (RTX 5070 Ti 16GB single GPU): 48 / 48
# Prod (RTX 2080 8GB per GPU):       16 / 2
LANE_BALL_BATCH_SIZE=48
SAM3D_BODY_BATCH_SIZE=48

# OOM/latency controls. Lower these before changing algorithm code.
MAX_VIDEO_FRAMES=600
MAX_VIDEO_DIMENSION=1024
LANE_BALL_MAX_VIDEO_DIMENSION=1280

# false: use the sensor-derived contact frame when available.
# true: ignore it and force the API's configured/demo start-frame behavior.
FORCE_LANE_BALL_START_FRAME=false

# Dev uses `docker-compose.yaml`, school/prod uses `docker-compose.prod.yaml`.
# Keep the shared ngrok overlay in both so `docker compose up --build` stays the same.
COMPOSE_FILE=docker-compose.yaml:docker-compose.ngrok.yaml

# Leave blank for local-only runs. Set to `ngrok` to start the Cloudflare tunnel sidecar.
COMPOSE_PROFILES=

# Multi-GPU: set to true for 2-GPU production (LaneBall→cuda:0, SAM3D→cuda:1)
MULTI_GPU=false
